{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scope.dev/schemas/scope_akta_review_summary.schema.json",
  "title": "SCOPE AKTA Review Summary",
  "type": "object",
  "required": [
    "status",
    "adapter_contract_version",
    "identity_assurance_level",
    "signing_assurance_level"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "session_required"]
    },
    "packet_path": { "type": "string" },
    "decision_path": { "type": "string" },
    "grant_path": { "type": "string" },
    "packet_id": { "type": "string" },
    "decision_id": { "type": "string" },
    "grant_id": { "type": "string" },
    "approved_scope": { "type": "string" },
    "requested_scope": { "type": "string" },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocked_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decision_type": { "type": "string" },
    "adapter_contract_version": {
      "type": "string",
      "enum": [
        "scope-akta-review-v0.8",
        "scope-akta-review-v0.9",
        "scope-akta-review-v1.0",
        "scope-akta-review-summary-v1.0"
      ]
    },
    "identity_assurance_level": {
      "type": "string",
      "enum": ["IAL0", "IAL1", "IAL2", "IAL3", "IAL4"]
    },
    "signing_assurance_level": {
      "type": "string",
      "enum": ["SAL0", "SAL1", "SAL2", "SAL3", "SAL4"]
    },
    "scope_trust_root_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "queue_id": { "type": "string" },
    "session_id": { "type": "string" },
    "required_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_review_role": { "type": "string" },
    "next_integration_action": { "type": "string" },
    "review_pending": { "type": "boolean" },
    "summary_origin": { "type": "string" },
    "assurance_source": { "type": "string" },
    "adapter_mode": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "required": ["approved_scope"],
        "allOf": [
          {
            "anyOf": [
              { "required": ["decision_id"] },
              { "required": ["decision_path"] }
            ]
          },
          {
            "anyOf": [
              { "required": ["grant_id"] },
              { "required": ["grant_path"] }
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "session_required" } },
        "required": ["status"]
      },
      "then": {
        "required": ["session_id"]
      }
    }
  ]
}
