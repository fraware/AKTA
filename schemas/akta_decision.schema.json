{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akta.dev/schemas/akta_decision.schema.json",
  "title": "AKTA Decision",
  "type": "object",
  "required": [
    "decision_id",
    "timestamp",
    "deployment_profile",
    "requested_action",
    "requested_tool",
    "scientific_action_type",
    "responsibility_level",
    "evidence_state",
    "validation_status",
    "verification_status",
    "admissibility",
    "decision_reason",
    "blocked_tools",
    "allowed_tools",
    "next_admissible_steps",
    "record_required",
    "review_required",
    "authorization_required",
    "policy_version",
    "policy_hash"
  ],
  "properties": {
    "decision_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "system_id": { "type": "string" },
    "deployment_profile": { "type": "string" },
    "domain": { "type": "string" },
    "requested_action": { "type": "string" },
    "requested_tool": { "type": "string" },
    "scientific_action_type": { "type": "string" },
    "responsibility_level": { "type": "string" },
    "evidence_state": { "type": "string" },
    "validation_status": { "type": "string" },
    "verification_status": { "type": "string" },
    "admissibility": {
      "type": "string",
      "enum": [
        "allowed",
        "allowed_with_logging",
        "draft_only",
        "review_required",
        "authorization_required",
        "blocked",
        "abstain_insufficient_context"
      ]
    },
    "decision_reason": { "type": "string" },
    "required_review_role": { "type": ["string", "null"] },
    "blocked_tools": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "next_admissible_steps": { "type": "array", "items": { "type": "string" } },
    "record_required": { "type": "boolean" },
    "review_required": { "type": "boolean" },
    "authorization_required": { "type": "boolean" },
    "consequentiality": { "type": "boolean" },
    "consequentiality_reason": { "type": "string" },
    "policy_version": { "type": "string" },
    "policy_hash": { "type": "string", "pattern": "^sha256:" },
    "domain_overlay_version": { "type": ["string", "null"] },
    "domain_overlay_hash": { "type": ["string", "null"], "pattern": "^sha256:" },
    "tool_registry_hash": { "type": "string", "pattern": "^sha256:" },
    "review_trigger": { "type": ["object", "null"] },
    "classifier_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "classification_rationale": { "type": "string" },
    "classification": { "type": "object" },
    "policy": {
      "type": "object",
      "description": "Effective policy provenance binding (directive §5)",
      "required": [
        "bundle_version",
        "effective_policy_hash",
        "manifest_hash",
        "integrity_mode"
      ],
      "properties": {
        "bundle_version": { "type": "string" },
        "effective_policy_hash": { "type": "string", "pattern": "^sha256:" },
        "manifest_hash": { "type": "string", "pattern": "^sha256:" },
        "integrity_mode": { "type": "string" },
        "signing_key_id": { "type": ["string", "null"] },
        "file_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "grant_layer_satisfaction": {
      "type": "object",
      "description": "Explicit layer satisfaction after SCOPE grant re-gate. Grants may satisfy human_review/authorization only; never evidence.",
      "properties": {
        "satisfied_layers": { "type": "array", "items": { "type": "object" } },
        "unsatisfied_layers": { "type": "array", "items": { "type": "object" } },
        "evidence_never_satisfied_by_grant": { "type": "boolean", "const": true },
        "forbidden_transitions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "capability_envelope": { "type": "object" },
    "review_satisfied": { "type": "boolean" },
    "authorization_satisfied": { "type": "boolean" }
  },
  "additionalProperties": true
}
