{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akta.dev/schemas/empirical_preregistration_amendment.v1.json",
  "title": "AKTA Empirical Preregistration Amendment",
  "description": "Signed amendment to a locked preregistration. Must be issued before observations start. Does not rewrite the locked preregistration.json artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amendment_id",
    "parent_content_hash",
    "reason",
    "changed_fields",
    "approval",
    "signature",
    "amended_at",
    "amendment_hash"
  ],
  "properties": {
    "amendment_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "parent_preregistration_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "changed_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changes": {
      "type": "object"
    },
    "approval": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "approver_id",
        "approver_role",
        "approved_at",
        "decision"
      ],
      "properties": {
        "approver_id": {
          "type": "string",
          "minLength": 1
        },
        "approver_role": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "const": "approved"
        }
      }
    },
    "amended_at": {
      "type": "string",
      "description": "UTC timestamp; must be strictly before observations_start_at",
      "format": "date-time"
    },
    "amendment_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "algorithm",
        "key_id",
        "public_key",
        "value",
        "signed_over"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "public_key": {
          "type": "string",
          "minLength": 1
        },
        "public_verification_key": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "signed_over": {
          "type": "string",
          "enum": [
            "amendment_hash",
            "content_hash"
          ]
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}
